{
  "name": "typebulb",
  "version": "0.32.0",
  "description": "Typebulb CLI to run single-file markdown apps called bulbs, either as standalone web apps or embedded in agent responses.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/typebulb/typebulb.git"
  },
  "homepage": "https://typebulb.com",
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "bin": {
    "typebulb": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/render.d.ts",
      "browser": "./dist/render.js",
      "import": "./dist/render.js",
      "default": "./dist/render.js"
    },
    "./servers": {
      "types": "./dist/servers.d.ts",
      "node": "./dist/servers.js",
      "import": "./dist/servers.js",
      "default": "./dist/servers.js"
    },
    "./ai": {
      "types": "./dist/ai/index.d.ts",
      "default": "./dist/ai/index.js"
    },
    "./format": {
      "types": "./dist/format/index.d.ts",
      "default": "./dist/format/index.js"
    },
    "./resolver": {
      "types": "./dist/resolver/index.d.ts",
      "default": "./dist/resolver/index.js"
    },
    "./dts": {
      "types": "./dist/dts/index.d.ts",
      "default": "./dist/dts/index.js"
    },
    "./lint": {
      "types": "./dist/lint/index.d.ts",
      "default": "./dist/lint/index.js"
    },
    "./transpile": {
      "types": "./dist/transpile/index.d.ts",
      "default": "./dist/transpile/index.js"
    }
  },
  "files": [
    "dist",
    "description.md"
  ],
  "scripts": {
    "typecheck": "tsc --build",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "build": "tsc --build && node esbuild.config.mjs",
    "clean": "rimraf dist cli/.tsbuild",
    "dev": "tsc --build && node dist/index.js",
    "prepublishOnly": "rimraf dist && tsc --build && node esbuild.config.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "chokidar": "^4.0.3",
    "es-module-lexer": "^1.7.0",
    "fflate": "^0.8.2",
    "hono": "^4.7.5",
    "lru-cache": "^11.2.2",
    "open": "^10.1.0",
    "p-limit": "^7.2.0",
    "resolve.exports": "^2.0.3",
    "semver": "^7.7.3",
    "sucrase": "^3.35.0",
    "xml-utils": "1.10.2",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.15.21",
    "@types/semver": "^7.7.0",
    "beautiful-mermaid": "^1.1.3",
    "domeleon": "^0.6.2",
    "dompurify": "^3.2.6",
    "esbuild": "^0.27.3",
    "highlight.js": "^11.10.0",
    "katex": "^0.16.22",
    "markdown-it": "^14.1.0",
    "matchu-patchu": "^0.3.1",
    "playwright": "^1.60.0",
    "rimraf": "^6.0.1",
    "typebox": "^1.3.4",
    "vitest": "^2.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
